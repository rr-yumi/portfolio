---
import "../css/main.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Yuzuki Portfolio",
  description = "Web制作・コーディング・デザイン・マーケティング対応のポートフォリオサイトです。",
  ogImage = "/images/ogp.png",
  ogImageAlt = `${title} のOGP画像`,
  noindex = false
} = Astro.props;

const siteName = "Yuzuki Portfolio";
const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = Astro.url && baseUrl ? new URL(Astro.url.pathname, baseUrl).toString() : "";
const pageUrl = canonicalUrl || Astro.url?.toString() || "";
const ogImageUrl = baseUrl ? new URL(ogImage, baseUrl).toString() : ogImage;
const ldJson = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: pageUrl,
  description,
  inLanguage: "ja"
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  </head>
  <body>
    <slot />
    <script>
      import "../js/custom.js";
    </script>
  </body>
</html>
