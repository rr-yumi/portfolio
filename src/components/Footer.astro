---
const copyright = "2026 portfolio";
const icon = 'public/images/arrow.svg';
---

<footer class="l-footer">
  <a class="p-footer__prompt" id="footer-prompt" href="#contact" aria-label="問い合わせる">問い合わせる</a>
  <div id="contact" class="l-footer__inner">
    <a href="#" class="p-contact__link">
      <h2 class="c-lv2Headeing__ttl p-contact__ttl">Contact</h2>
      <p class="p-contact">
        <span class="p-contact__textWrap" aria-hidden="true">
          <span class="p-contact__text p-contact__text--base">お仕事のご相談、お待ちしております。</span>
          <span class="p-contact__text p-contact__text--hover">お仕事のご相談、お待ちしております。</span>
        </span>
        <span class="p-contact__iconWrap" aria-hidden="true">
          <span class="p-contact__icon p-contact__icon--base"><img src={icon} alt="矢印"></span>
          <span class="p-contact__icon p-contact__icon--hover"><img src={icon} alt=""></span>
        </span>
      </p>
    </a>
  </div>
  <p class="p-copyright">&copy; {copyright}</p>
</footer>
