---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getWorks } from '../lib/notion';

const image = '/images/about_img.png';
const web = '/images/web.jpg';
const ec = '/images/ec.jpg';
const marketing = '/images/marketing.jpg';
const { items: works, error: worksError } = await getWorks();
const topWorks = works.slice(0, 6);
const worksCountLabel = `${works.length}+ Projects`;
const seo = {
  title: "Portfolio | コーディング・Web制作",
  description: "WordPress・Astroを中心に、Web制作、デザイン、広告運用まで対応いたします。",
  ogImage: "/images/ogp.png"
};
---
<Layout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
	<Header />

	
	<main>
		<div id="service" class="l-skills l-section">
			<div class="c-lv2Headeing">
				<h2 class="c-lv2Headeing__ttl">SERVICE</h2>
			</div>
			<div class="p-skills">
				<ul class="p-skills__list">
					<li class="p-skills__item">
						<figure class="p-skills__img">
						<img src={web} alt="Web制作">
						</figure>	
						<h3 class="c-lv3Headeing__ttl">Webサイト＆LP制作【デザインからコーディングまで】</h3>
							<p>HTML/CSS・Wordpress構築・Astro構築<br>
							GSAPなどを使った多彩なアニメーションの実装</p>
					</li>

					<li class="p-skills__item">
						<figure class="p-skills__img">
						<img src={ec} alt="Web制作">
						</figure>	
						<h3 class="c-lv3Headeing__ttl">ECサイト制作</h3>
						<span>Shopify構築・カラーミーショップ構築</span>
					</li>

					<li class="p-skills__item">
						<figure class="p-skills__img">
						<img src={marketing} alt="Web制作">
						</figure>	
						<h3 class="c-lv3Headeing__ttl">Web広告運用【解析ツールの設置から運用まで】</h3>
						<p>Google広告・Yahoo!広告・Meta広告<br>
						広告レポート作成・分析・改善提案</p>
					</li>
				</ul>
			</div>

		</div>

		<div id="works" class="l-works l-section">
			<div class="c-lv2Headeing">
				<h2 class="c-lv2Headeing__ttl">WORKS</h2>
			</div>
			<div class="p-works">
				{topWorks.length > 0 ? (
					<ul class="p-works__list">
						{topWorks.map((work) => (
							<li class="p-works__item">
								<h3 class="p-works__title">{work.title}</h3>
								<div class="p-works__meta">
									{work.industry && (
										<div class="p-works__row">
											<p class="p-works__label">業界</p>
											<p class="p-works__text">{work.industry}</p>
										</div>
									)}
									{work.responsibilities.length > 0 && (
										<div class="p-works__row">
											<p class="p-works__label">担当範囲</p>
											<div class="p-works__tags">
												{work.responsibilities.map((item) => (
													<span class="p-works__tag">{item}</span>
												))}
											</div>
										</div>
									)}
									{work.technologies.length > 0 && (
										<div class="p-works__row">
											<p class="p-works__label">使用技術</p>
											<div class="p-works__tags">
												{work.technologies.map((item) => (
													<span class="p-works__tag">{item}</span>
												))}
											</div>
										</div>
									)}
								</div>
							</li>
						))}
					</ul>
				) : (
					<div class="p-works__empty">
						<p>
							Notionの実績テーブルを連携すると、ここに一覧表示されます。<br />
							このPORTFOLIO(ポートフォリオ)はAstroで構築しています。
						</p>
						{worksError && <p class="p-works__error">{worksError}</p>}
					</div>
				)}
				{works.length > 6 && (
					<div class="p-works__actions">
						<a class="c-button" href="/works/" aria-label="すべての実績">
							<span class="c-button__textWrap" aria-hidden="true">
								<span class="c-button__text c-button__text--base">すべての実績</span>
								<span class="c-button__text c-button__text--hover">すべての実績</span>
							</span>
							<span class="c-button__iconWrap" aria-hidden="true">
								<span class="c-button__icon c-button__icon--base"><img src="/images/arrow_dark.svg" alt="矢印" /></span>
								<span class="c-button__icon c-button__icon--hover"><img src="/images/arrow_dark.svg" alt="" /></span>
							</span>
						</a>
					</div>
				)}
			</div>
		</div>

		<div id="about" class="l-about l-section">
			<div class="c-lv2Headeing">
				<h2 class="c-lv2Headeing__ttl">ABOUT</h2>
			</div>

			<div class="p-about">
				<p class="p-about__text">
					現在広告代理店でコーダーとして働いています。
					</p>
					<p class="p-about__text">
				WordPressを中心に、Astro・STUDIOを用いたWebサイト制作や、Shopify・カラーミーでのECサイト構築に携わっています。<br>
				また、Laravelを用いたシステムの運用・保守にも携わり、既存機能の改修やメンテナンスを行っています。	
					</p>
					<p class="p-about__text">	
デザインや広告運用にも携わっているため、コーディングだけでなく、サイト全体の目的やユーザー体験を意識したWeb制作を心がけています。<br>
新しい技術や知識を積極的に学びながら、より良いサイトづくりを目指しています。
					</p>
			<ul class="p-about__list">
				<li class="p-about__item">
					<p class="p-about__en">
					5year
					</p>
					<h3 class="p-about__label">
					IT業界歴
					</h3>	
				</li>
				<li class="p-about__item">
					<p class="p-about__en">
					{worksCountLabel}
					</p>
					<h3 class="p-about__label">
					掲載制作実績
					</h3>	
				</li>
				<li class="p-about__item">
					<p class="p-about__en">
					10 Technologies
					</p>
					<h3 class="p-about__label">
					WordPress／Astro／Laravel／Shopify／カラーミー／STUDIO／GoogleAds／Yahoo!Ads／Meta Ads／Figma
					</h3>	
				</li>
			</ul>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
