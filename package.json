{
  "name": "helpless-houston",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sass:build": "sass src/scss/main.scss src/css/main.css --no-source-map",
